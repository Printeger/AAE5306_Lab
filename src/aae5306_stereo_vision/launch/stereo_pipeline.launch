<!-- 
  Complete Stereo Vision Pipeline Launch File
  
  This launch file starts the complete pipeline:
  1. Feature detection on both cameras
  2. Feature matching between stereo pairs
  3. Depth recovery and point cloud generation
  
  Usage:
    roslaunch aae5306_stereo_vision stereo_pipeline.launch
    
  Then play the rosbag:
    rosbag play MH_01_easy.bag
-->

<launch>
  <!-- Arguments -->
  <arg name="detector_type" default="orb" doc="Feature detector: sift, orb (use orb if SIFT not available)"/>
  <arg name="ratio_threshold" default="0.75" doc="Lowe's ratio test threshold"/>
  <arg name="epipolar_threshold" default="2.0" doc="Epipolar constraint threshold (pixels)"/>
  <arg name="visualize" default="true" doc="Enable visualization"/>
  <arg name="min_depth" default="0.5" doc="Minimum valid depth (meters)"/>
  <arg name="max_depth" default="15.0" doc="Maximum valid depth (meters)"/>
  
  <!-- Camera calibration parameters (EuRoC MH_01) -->
  <arg name="fx" default="458.654" doc="Focal length x"/>
  <arg name="fy" default="457.296" doc="Focal length y"/>
  <arg name="cx" default="367.215" doc="Principal point x"/>
  <arg name="cy" default="248.375" doc="Principal point y"/>
  <arg name="baseline" default="0.110074" doc="Stereo baseline (meters)"/>
  
  <!-- Camera topics -->
  <arg name="cam0_topic" default="/cam0/image_raw" doc="Left camera topic"/>
  <arg name="cam1_topic" default="/cam1/image_raw" doc="Right camera topic"/>

  <!-- 1. Feature Detection - Left Camera -->
  <node name="feature_detection_cam0" pkg="aae5306_stereo_vision" type="feature_detection_node.py" output="screen">
    <param name="detector_type" value="$(arg detector_type)"/>
    <param name="input_topic" value="$(arg cam0_topic)"/>
    <param name="visualize" value="$(arg visualize)"/>
    <param name="publish_rate" value="10.0"/>
    <remap from="~features_image" to="/stereo_vision/cam0/features_image"/>
    <remap from="~feature_stats" to="/stereo_vision/cam0/feature_stats"/>
  </node>

  <!-- 2. Feature Detection - Right Camera -->
  <node name="feature_detection_cam1" pkg="aae5306_stereo_vision" type="feature_detection_node.py" output="screen">
    <param name="detector_type" value="$(arg detector_type)"/>
    <param name="input_topic" value="$(arg cam1_topic)"/>
    <param name="visualize" value="$(arg visualize)"/>
    <param name="publish_rate" value="10.0"/>
    <remap from="~features_image" to="/stereo_vision/cam1/features_image"/>
    <remap from="~feature_stats" to="/stereo_vision/cam1/feature_stats"/>
  </node>

  <!-- 3. Feature Matching -->
  <node name="feature_matching" pkg="aae5306_stereo_vision" type="feature_matching_node.py" output="screen">
    <param name="detector_type" value="$(arg detector_type)"/>
    <param name="ratio_threshold" value="$(arg ratio_threshold)"/>
    <param name="epipolar_threshold" value="$(arg epipolar_threshold)"/>
    <param name="left_topic" value="$(arg cam0_topic)"/>
    <param name="right_topic" value="$(arg cam1_topic)"/>
    <param name="visualize" value="$(arg visualize)"/>
    <param name="max_delay" value="0.1"/>
    <remap from="~matches_image" to="/stereo_vision/matches_image"/>
    <remap from="~match_stats" to="/stereo_vision/match_stats"/>
  </node>

  <!-- 4. Depth Recovery -->
  <node name="depth_recovery" pkg="aae5306_stereo_vision" type="depth_recovery_node.py" output="screen">
    <!-- Camera calibration -->
    <param name="fx" value="$(arg fx)"/>
    <param name="fy" value="$(arg fy)"/>
    <param name="cx" value="$(arg cx)"/>
    <param name="cy" value="$(arg cy)"/>
    <param name="baseline" value="$(arg baseline)"/>
    
    <!-- Processing parameters -->
    <param name="detector_type" value="$(arg detector_type)"/>
    <param name="ratio_threshold" value="$(arg ratio_threshold)"/>
    <param name="epipolar_threshold" value="$(arg epipolar_threshold)"/>
    <param name="min_depth" value="$(arg min_depth)"/>
    <param name="max_depth" value="$(arg max_depth)"/>
    
    <!-- Topics -->
    <param name="left_topic" value="$(arg cam0_topic)"/>
    <param name="right_topic" value="$(arg cam1_topic)"/>
    <param name="max_delay" value="0.1"/>
    
    <remap from="~pointcloud" to="/stereo_vision/pointcloud"/>
    <remap from="~depth_image" to="/stereo_vision/depth_image"/>
    <remap from="~depth_stats" to="/stereo_vision/depth_stats"/>
  </node>

  <!-- 5. RViz Visualization -->
  <node if="$(arg visualize)" name="rviz" pkg="rviz" type="rviz" 
        args="-d $(find aae5306_stereo_vision)/rviz/stereo_vision.rviz" output="screen"/>

</launch>
