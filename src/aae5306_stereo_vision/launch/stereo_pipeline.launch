<!-- 
  Complete Stereo Vision Pipeline Launch File
  
  This launch file starts the complete pipeline:
  1. Feature detection on both cameras
  2. Feature matching between stereo pairs
  3. Depth recovery and point cloud generation
  
  Usage:
    roslaunch aae5306_stereo_vision stereo_pipeline.launch
    
  Then play the rosbag:
    rosbag play MH_01_easy.bag
-->

<launch>
  <arg name="config_file" default="$(find aae5306_stereo_vision)/config/stereo_params.yaml"/>

  <rosparam command="load" file="$(arg config_file)"/>

  <node name="feature_detection_cam0" pkg="aae5306_stereo_vision" type="feature_detection_node.py" output="screen"/>
  <node name="feature_detection_cam1" pkg="aae5306_stereo_vision" type="feature_detection_node.py" output="screen"/>
  <node name="feature_matching" pkg="aae5306_stereo_vision" type="feature_matching_node.py" output="screen"/>
  <node name="depth_recovery" pkg="aae5306_stereo_vision" type="depth_recovery_node.py" output="screen"/>
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find aae5306_stereo_vision)/rviz/stereo_vision.rviz" output="screen"/>

</launch>
