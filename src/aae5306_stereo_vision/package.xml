<?xml version="1.0"?>
<package format="2">
  <name>aae5306_stereo_vision</name>
  <version>1.0.0</version>
  <description>
    AAE5306 Lab: Real-time Stereo Vision Processing Pipeline
    This package implements feature detection, matching, and depth recovery
    for stereo camera systems using the EuRoC MAV dataset.
  </description>

  <maintainer email="aae5306@example.com">AAE5306 Teaching Team</maintainer>
  <license>MIT</license>

  <author>AAE5306 Teaching Team</author>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- ROS dependencies -->
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  
  <!-- Build dependencies -->
  <build_depend>message_generation</build_depend>
  
  <!-- Runtime dependencies -->
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>image_view</exec_depend>

  <export>
  </export>
</package>
